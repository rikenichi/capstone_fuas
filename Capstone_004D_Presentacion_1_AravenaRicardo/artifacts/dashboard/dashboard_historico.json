      },
      "edad": {
        "periodo": "2008-2025",
        "descripcion": "Disponible durante toda la serie. Se consideran edades plausibles entre 10 y 130 años. La cobertura es parcial en algunos años iniciales."
      },
      "quintil": {
        "periodos": [
          "2013-2018",
          "2022-2025"
        ],
        "descripcion": "QUINTIL_SE4 no está disponible en los archivos FUAS 2019-2021. En 2018 la cobertura de quintiles válidos 1-5 es 99,47%."
      }
    }
